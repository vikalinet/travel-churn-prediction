# Переменные окружения проекта. Скопируйте в .env и заполните нужные;
# сам .env в git не попадает (.gitignore). Все переменные необязательны.

# Папка для того, что программа пишет при работе (свежие отчёты о дрейфе).
# По умолчанию — runtime/ в корне проекта. См. src/settings.py.
CHURN_RUNTIME_DIR=

# База экспериментов MLflow. По умолчанию — sqlite:///<корень>/mlflow.db.
# В docker-compose задаётся адрес сервера MLflow.
MLFLOW_TRACKING_URI=
# Ссылка на интерфейс MLflow на странице мониторинга.
MLFLOW_UI_URL=

# Уведомления о дрейфе данных в Telegram (секреты — не коммитить!).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Адрес развёрнутого приложения — для ссылки в уведомлении.
APP_URL=

# Веб-хук для уведомлений о дрейфе (src/monitoring/drift_monitor.py).
DRIFT_WEBHOOK_URL=

# Порт API при запуске python -m src.api.main.
PORT=8000
