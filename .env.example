# Пример конфигурации для проекта
# Скопируйте этот файл в .env и настройте под вашу среду

# API настройки
API_V1_PREFIX=/api/v1
APP_TITLE=Travel Churn Prediction API
APP_DESCRIPTION=API для прогнозирования оттока клиентов туристического агентства
APP_VERSION=1.0.0
HOST=0.0.0.0
PORT=8000

# Путь к модели
MODEL_PATH=models/best_model.pkl

# MLflow
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
MLFLOW_UI_URL=http://localhost:5000

# Пороги для уровней риска
RISK_LOW_THRESHOLD=0.3
RISK_HIGH_THRESHOLD=0.7

# Rate limiting (запросы в минуту)
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=minute

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s %(levelname)s %(message)s %(name)s

# Cache (TTL в секундах)
CACHE_TTL=300
CACHE_MAX_SIZE=1000

# Prometheus metrics
PROMETHEUS_ENABLED=true

# Telegram уведомления (опционально)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Webhook для алертов дрейфа (опционально)
DRIFT_WEBHOOK_URL=
