<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions id="model_lifecycle" targetNamespace="https://github.com/vikalinet/travel-churn-prediction" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
<bpmn:collaboration id="collaboration"><bpmn:participant id="pool" name="Жизненный цикл travel-churn-model" processRef="lifecycle" /></bpmn:collaboration>
<bpmn:process id="lifecycle" name="Жизненный цикл модели оттока" isExecutable="false">
<bpmn:laneSet id="lanes"><bpmn:lane id="lane_ds" name="Data Scientist"><bpmn:flowNodeRef>start</bpmn:flowNodeRef><bpmn:flowNodeRef>prep</bpmn:flowNodeRef><bpmn:flowNodeRef>train</bpmn:flowNodeRef><bpmn:flowNodeRef>gw_metrics</bpmn:flowNodeRef><bpmn:flowNodeRef>card</bpmn:flowNodeRef><bpmn:flowNodeRef>analyze</bpmn:flowNodeRef><bpmn:flowNodeRef>gw_retrain</bpmn:flowNodeRef><bpmn:flowNodeRef>end_keep</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="lane_ci" name="CI/CD (GitHub Actions)"><bpmn:flowNodeRef>checks</bpmn:flowNodeRef><bpmn:flowNodeRef>gw_ci</bpmn:flowNodeRef><bpmn:flowNodeRef>build</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="lane_owner" name="Владелец модели"><bpmn:flowNodeRef>review</bpmn:flowNodeRef><bpmn:flowNodeRef>gw_approve</bpmn:flowNodeRef><bpmn:flowNodeRef>merge</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="lane_prod" name="Эксплуатация"><bpmn:flowNodeRef>deploy</bpmn:flowNodeRef><bpmn:flowNodeRef>gw_smoke</bpmn:flowNodeRef><bpmn:flowNodeRef>rollback</bpmn:flowNodeRef><bpmn:flowNodeRef>end_rollback</bpmn:flowNodeRef><bpmn:flowNodeRef>serve</bpmn:flowNodeRef><bpmn:flowNodeRef>timer</bpmn:flowNodeRef><bpmn:flowNodeRef>drift</bpmn:flowNodeRef><bpmn:flowNodeRef>gw_drift</bpmn:flowNodeRef><bpmn:flowNodeRef>alert</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet>
<bpmn:startEvent id="start" name="Нужна новая версия модели"><bpmn:outgoing>flow_0</bpmn:outgoing></bpmn:startEvent>
<bpmn:userTask id="prep" name="Подготовить данные (ETL)"><bpmn:incoming>flow_0</bpmn:incoming><bpmn:incoming>flow_26</bpmn:incoming><bpmn:outgoing>flow_1</bpmn:outgoing></bpmn:userTask>
<bpmn:userTask id="train" name="Обучить и сравнить модели, версия в MLflow"><bpmn:incoming>flow_1</bpmn:incoming><bpmn:incoming>flow_4</bpmn:incoming><bpmn:outgoing>flow_2</bpmn:outgoing></bpmn:userTask>
<bpmn:exclusiveGateway id="gw_metrics" name="Не хуже champion?"><bpmn:incoming>flow_2</bpmn:incoming><bpmn:outgoing>flow_3</bpmn:outgoing><bpmn:outgoing>flow_4</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:userTask id="card" name="Обновить Model Card, открыть PR"><bpmn:incoming>flow_3</bpmn:incoming><bpmn:incoming>flow_8</bpmn:incoming><bpmn:incoming>flow_11</bpmn:incoming><bpmn:outgoing>flow_5</bpmn:outgoing></bpmn:userTask>
<bpmn:serviceTask id="checks" name="Линтеры, mypy, тесты, покрытие ≥ 60 %"><bpmn:incoming>flow_5</bpmn:incoming><bpmn:outgoing>flow_6</bpmn:outgoing></bpmn:serviceTask>
<bpmn:exclusiveGateway id="gw_ci" name="CI зелёный?"><bpmn:incoming>flow_6</bpmn:incoming><bpmn:outgoing>flow_7</bpmn:outgoing><bpmn:outgoing>flow_8</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:userTask id="review" name="Ревью кода, метрик и Model Card"><bpmn:incoming>flow_7</bpmn:incoming><bpmn:outgoing>flow_9</bpmn:outgoing></bpmn:userTask>
<bpmn:exclusiveGateway id="gw_approve" name="Одобрено?"><bpmn:incoming>flow_9</bpmn:incoming><bpmn:outgoing>flow_10</bpmn:outgoing><bpmn:outgoing>flow_11</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:userTask id="merge" name="Merge в main"><bpmn:incoming>flow_10</bpmn:incoming><bpmn:outgoing>flow_12</bpmn:outgoing></bpmn:userTask>
<bpmn:serviceTask id="build" name="Сборка Docker- образа; release: — публикация"><bpmn:incoming>flow_12</bpmn:incoming><bpmn:outgoing>flow_13</bpmn:outgoing></bpmn:serviceTask>
<bpmn:userTask id="deploy" name="Развернуть, проверить /health и версию"><bpmn:incoming>flow_13</bpmn:incoming><bpmn:outgoing>flow_14</bpmn:outgoing></bpmn:userTask>
<bpmn:exclusiveGateway id="gw_smoke" name="Работает?"><bpmn:incoming>flow_14</bpmn:incoming><bpmn:outgoing>flow_15</bpmn:outgoing><bpmn:outgoing>flow_16</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:userTask id="rollback" name="Откат на предыдущую версию"><bpmn:incoming>flow_16</bpmn:incoming><bpmn:outgoing>flow_17</bpmn:outgoing></bpmn:userTask>
<bpmn:endEvent id="end_rollback" name="Прежняя версия в работе"><bpmn:incoming>flow_17</bpmn:incoming></bpmn:endEvent>
<bpmn:serviceTask id="serve" name="Прогнозы, журнал запросов"><bpmn:incoming>flow_15</bpmn:incoming><bpmn:incoming>flow_22</bpmn:incoming><bpmn:outgoing>flow_18</bpmn:outgoing></bpmn:serviceTask>
<bpmn:intermediateCatchEvent id="timer" name="Ежедневно 9:00 UTC"><bpmn:incoming>flow_18</bpmn:incoming><bpmn:outgoing>flow_19</bpmn:outgoing><bpmn:timerEventDefinition id="timer_def"><bpmn:timeCycle xsi:type="bpmn:tFormalExpression">R/P1D</bpmn:timeCycle></bpmn:timerEventDefinition></bpmn:intermediateCatchEvent>
<bpmn:serviceTask id="drift" name="Проверка дрейфа: KS, JS, PSI"><bpmn:incoming>flow_19</bpmn:incoming><bpmn:outgoing>flow_20</bpmn:outgoing></bpmn:serviceTask>
<bpmn:exclusiveGateway id="gw_drift" name="Дрейф?"><bpmn:incoming>flow_20</bpmn:incoming><bpmn:outgoing>flow_21</bpmn:outgoing><bpmn:outgoing>flow_22</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:sendTask id="alert" name="Telegram и письмо GitHub"><bpmn:incoming>flow_21</bpmn:incoming><bpmn:outgoing>flow_23</bpmn:outgoing></bpmn:sendTask>
<bpmn:userTask id="analyze" name="Разобрать причину дрейфа"><bpmn:incoming>flow_23</bpmn:incoming><bpmn:outgoing>flow_24</bpmn:outgoing></bpmn:userTask>
<bpmn:exclusiveGateway id="gw_retrain" name="Нужно переобучение?"><bpmn:incoming>flow_24</bpmn:incoming><bpmn:outgoing>flow_25</bpmn:outgoing><bpmn:outgoing>flow_26</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:endEvent id="end_keep" name="Модель остаётся"><bpmn:incoming>flow_25</bpmn:incoming></bpmn:endEvent>
<bpmn:sequenceFlow id="flow_0" sourceRef="start" targetRef="prep" />
<bpmn:sequenceFlow id="flow_1" sourceRef="prep" targetRef="train" />
<bpmn:sequenceFlow id="flow_2" sourceRef="train" targetRef="gw_metrics" />
<bpmn:sequenceFlow id="flow_3" sourceRef="gw_metrics" targetRef="card" name="да" />
<bpmn:sequenceFlow id="flow_4" sourceRef="gw_metrics" targetRef="train" name="нет" />
<bpmn:sequenceFlow id="flow_5" sourceRef="card" targetRef="checks" />
<bpmn:sequenceFlow id="flow_6" sourceRef="checks" targetRef="gw_ci" />
<bpmn:sequenceFlow id="flow_7" sourceRef="gw_ci" targetRef="review" name="да" />
<bpmn:sequenceFlow id="flow_8" sourceRef="gw_ci" targetRef="card" name="нет" />
<bpmn:sequenceFlow id="flow_9" sourceRef="review" targetRef="gw_approve" />
<bpmn:sequenceFlow id="flow_10" sourceRef="gw_approve" targetRef="merge" name="да" />
<bpmn:sequenceFlow id="flow_11" sourceRef="gw_approve" targetRef="card" name="нет" />
<bpmn:sequenceFlow id="flow_12" sourceRef="merge" targetRef="build" />
<bpmn:sequenceFlow id="flow_13" sourceRef="build" targetRef="deploy" />
<bpmn:sequenceFlow id="flow_14" sourceRef="deploy" targetRef="gw_smoke" />
<bpmn:sequenceFlow id="flow_15" sourceRef="gw_smoke" targetRef="serve" name="да" />
<bpmn:sequenceFlow id="flow_16" sourceRef="gw_smoke" targetRef="rollback" name="нет" />
<bpmn:sequenceFlow id="flow_17" sourceRef="rollback" targetRef="end_rollback" />
<bpmn:sequenceFlow id="flow_18" sourceRef="serve" targetRef="timer" />
<bpmn:sequenceFlow id="flow_19" sourceRef="timer" targetRef="drift" />
<bpmn:sequenceFlow id="flow_20" sourceRef="drift" targetRef="gw_drift" />
<bpmn:sequenceFlow id="flow_21" sourceRef="gw_drift" targetRef="alert" name="да" />
<bpmn:sequenceFlow id="flow_22" sourceRef="gw_drift" targetRef="serve" name="нет" />
<bpmn:sequenceFlow id="flow_23" sourceRef="alert" targetRef="analyze" />
<bpmn:sequenceFlow id="flow_24" sourceRef="analyze" targetRef="gw_retrain" />
<bpmn:sequenceFlow id="flow_25" sourceRef="gw_retrain" targetRef="end_keep" name="нет" />
<bpmn:sequenceFlow id="flow_26" sourceRef="gw_retrain" targetRef="prep" name="да" />
</bpmn:process>
