<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions id="model_retrain" targetNamespace="https://github.com/vikalinet/travel-churn-prediction" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
<bpmn:collaboration id="collaboration"><bpmn:participant id="pool" name="Переобучение travel-churn-model" processRef="model_retrain_process" /></bpmn:collaboration>
<bpmn:process id="model_retrain_process" name="Переобучение travel-churn-model" isExecutable="false">
<bpmn:laneSet id="lanes"><bpmn:lane id="lane_ds" name="Data Scientist"><bpmn:flowNodeRef>start</bpmn:flowNodeRef><bpmn:flowNodeRef>prep</bpmn:flowNodeRef><bpmn:flowNodeRef>train</bpmn:flowNodeRef><bpmn:flowNodeRef>gw_quality</bpmn:flowNodeRef><bpmn:flowNodeRef>card</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="lane_ci" name="CI/CD (GitHub Actions)"><bpmn:flowNodeRef>checks</bpmn:flowNodeRef><bpmn:flowNodeRef>gw_ci</bpmn:flowNodeRef><bpmn:flowNodeRef>build</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="lane_owner" name="Владелец модели"><bpmn:flowNodeRef>review</bpmn:flowNodeRef><bpmn:flowNodeRef>gw_publish</bpmn:flowNodeRef><bpmn:flowNodeRef>register</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="lane_prod" name="Эксплуатация"><bpmn:flowNodeRef>deploy</bpmn:flowNodeRef><bpmn:flowNodeRef>gw_health</bpmn:flowNodeRef><bpmn:flowNodeRef>rollback</bpmn:flowNodeRef><bpmn:flowNodeRef>end_fail</bpmn:flowNodeRef><bpmn:flowNodeRef>end_ok</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet>
<bpmn:startEvent id="start" name="Триггер: дрейф / новые данные / плановый запуск"><bpmn:outgoing>flow_0</bpmn:outgoing></bpmn:startEvent>
<bpmn:userTask id="prep" name="Получить и подготовить новые данные"><bpmn:incoming>flow_0</bpmn:incoming><bpmn:outgoing>flow_1</bpmn:outgoing></bpmn:userTask>
<bpmn:userTask id="train" name="Обучить новую версию модели"><bpmn:incoming>flow_1</bpmn:incoming><bpmn:incoming>flow_4</bpmn:incoming><bpmn:outgoing>flow_2</bpmn:outgoing></bpmn:userTask>
<bpmn:exclusiveGateway id="gw_quality" name="Качество не хуже champion?"><bpmn:incoming>flow_2</bpmn:incoming><bpmn:outgoing>flow_3</bpmn:outgoing><bpmn:outgoing>flow_4</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:userTask id="card" name="Обновить Model Card, открыть PR"><bpmn:incoming>flow_3</bpmn:incoming><bpmn:incoming>flow_8</bpmn:incoming><bpmn:incoming>flow_11</bpmn:incoming><bpmn:outgoing>flow_5</bpmn:outgoing></bpmn:userTask>
<bpmn:serviceTask id="checks" name="Линтеры, тесты, покрытие ≥ 60 %"><bpmn:incoming>flow_5</bpmn:incoming><bpmn:outgoing>flow_6</bpmn:outgoing></bpmn:serviceTask>
<bpmn:exclusiveGateway id="gw_ci" name="CI зелёный?"><bpmn:incoming>flow_6</bpmn:incoming><bpmn:outgoing>flow_7</bpmn:outgoing><bpmn:outgoing>flow_8</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:userTask id="review" name="Ревью: код, метрики, Model Card"><bpmn:incoming>flow_7</bpmn:incoming><bpmn:outgoing>flow_9</bpmn:outgoing></bpmn:userTask>
<bpmn:exclusiveGateway id="gw_publish" name="Публиковать новую версию?"><bpmn:incoming>flow_9</bpmn:incoming><bpmn:outgoing>flow_10</bpmn:outgoing><bpmn:outgoing>flow_11</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:userTask id="register" name="Merge: версия становится champion в MLflow"><bpmn:incoming>flow_10</bpmn:incoming><bpmn:outgoing>flow_12</bpmn:outgoing></bpmn:userTask>
<bpmn:serviceTask id="build" name="Сборка и публикация Docker-образа"><bpmn:incoming>flow_12</bpmn:incoming><bpmn:outgoing>flow_13</bpmn:outgoing></bpmn:serviceTask>
<bpmn:userTask id="deploy" name="Развернуть, проверить /health и версию"><bpmn:incoming>flow_13</bpmn:incoming><bpmn:outgoing>flow_14</bpmn:outgoing></bpmn:userTask>
<bpmn:exclusiveGateway id="gw_health" name="Работает?"><bpmn:incoming>flow_14</bpmn:incoming><bpmn:outgoing>flow_15</bpmn:outgoing><bpmn:outgoing>flow_16</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:userTask id="rollback" name="Откат на предыдущую версию"><bpmn:incoming>flow_16</bpmn:incoming><bpmn:outgoing>flow_17</bpmn:outgoing></bpmn:userTask>
<bpmn:endEvent id="end_fail" name="Прежняя версия осталась; разбор причин"><bpmn:incoming>flow_17</bpmn:incoming></bpmn:endEvent>
<bpmn:endEvent id="end_ok" name="Новая версия в эксплуатации"><bpmn:incoming>flow_15</bpmn:incoming></bpmn:endEvent>
<bpmn:sequenceFlow id="flow_0" sourceRef="start" targetRef="prep" />
<bpmn:sequenceFlow id="flow_1" sourceRef="prep" targetRef="train" />
<bpmn:sequenceFlow id="flow_2" sourceRef="train" targetRef="gw_quality" />
<bpmn:sequenceFlow id="flow_3" sourceRef="gw_quality" targetRef="card" name="да" />
<bpmn:sequenceFlow id="flow_4" sourceRef="gw_quality" targetRef="train" name="нет, доработать" />
<bpmn:sequenceFlow id="flow_5" sourceRef="card" targetRef="checks" />
<bpmn:sequenceFlow id="flow_6" sourceRef="checks" targetRef="gw_ci" />
<bpmn:sequenceFlow id="flow_7" sourceRef="gw_ci" targetRef="review" name="да" />
<bpmn:sequenceFlow id="flow_8" sourceRef="gw_ci" targetRef="card" name="нет" />
<bpmn:sequenceFlow id="flow_9" sourceRef="review" targetRef="gw_publish" />
<bpmn:sequenceFlow id="flow_10" sourceRef="gw_publish" targetRef="register" name="да" />
<bpmn:sequenceFlow id="flow_11" sourceRef="gw_publish" targetRef="card" name="нет, доработка" />
<bpmn:sequenceFlow id="flow_12" sourceRef="register" targetRef="build" />
<bpmn:sequenceFlow id="flow_13" sourceRef="build" targetRef="deploy" />
<bpmn:sequenceFlow id="flow_14" sourceRef="deploy" targetRef="gw_health" />
<bpmn:sequenceFlow id="flow_15" sourceRef="gw_health" targetRef="end_ok" name="да" />
<bpmn:sequenceFlow id="flow_16" sourceRef="gw_health" targetRef="rollback" name="нет" />
<bpmn:sequenceFlow id="flow_17" sourceRef="rollback" targetRef="end_fail" />
</bpmn:process>
<bpmndi:BPMNDiagram id="diagram"><bpmndi:BPMNPlane id="plane" bpmnElement="collaboration">
